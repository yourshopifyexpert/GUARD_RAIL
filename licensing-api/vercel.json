{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "stripe/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/generate-key",
      "dest": "/api/generate-key.ts"
    },
    {
      "src": "/api/validate-key",
      "dest": "/api/validate-key.ts"
    },
    {
      "src": "/api/activate-trial",
      "dest": "/api/activate-trial.ts"
    },
    {
      "src": "/stripe/create-checkout",
      "dest": "/stripe/create-checkout.ts"
    },
    {
      "src": "/stripe/webhook",
      "dest": "/stripe/webhook.ts"
    },
    {
      "src": "/stripe/create-portal-session",
      "dest": "/stripe/create-portal-session.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
