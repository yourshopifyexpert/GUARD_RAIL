{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "node",
    "outDir": "out/webview",
    "rootDir": "src/webview"
  },
  "include": [
    "src/webview/**/*"
  ],
  "exclude": [
